<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/remote_scanner_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface">
  <TextView android:id="@+id/remote_scanner_status" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:padding="18dp" android:text="@string/remote_scan_instructions" android:textSize="16sp" android:textColor="@color/text" android:accessibilityLiveRegion="polite" />
  <TextureView android:id="@+id/remote_camera_preview" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
  <Button android:id="@+id/remote_scan_manual" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/remote_manual_instead" />
</LinearLayout>
