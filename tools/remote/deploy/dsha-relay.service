[Unit]
Description=DSHA authenticated rendezvous and encrypted Circuit Relay v2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dsha-relay
Group=dsha-relay
Environment=DSHA_RELAY_CONFIG=/etc/dsha-relay/config.json
EnvironmentFile=-/etc/dsha-relay/relay.env
ExecStart=/opt/dsha-relay/dsha-relay
WorkingDirectory=/var/lib/dsha-relay
StateDirectory=dsha-relay
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
LimitNOFILE=2048
TasksMax=256
MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=multi-user.target
